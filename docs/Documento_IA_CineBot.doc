\pard\qc\fs17\i\cf3 Figura 3. Distribuci\u243?n de las valoraciones de MovieLens.\i0\cf1\par
\pard\sa180\sb240\f1\fs34\b\cf2 5. Dise\u241?o de la base de datos\b0\cf1\par
\pard\qj\sa120\sl276\slmult1\fs21 El esquema se implement\u243? en SQLite 3 y se versiona en `database/schema.sql`. La base `database/cinebot.db` se genera con un script idempotente que crea el esquema, importa el cat\u225?logo y carga las valoraciones. El dise\u241?o busca integridad, consultas eficientes y trazabilidad del comportamiento del chatbot.\par
\pard\sa120\sb180\fs26\b\cf1 5.1. Tablas principales\b0\par
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17\b Tabla\b0\cell \pard\intbl\fs17\b Funci\u243?n\b0\cell \pard\intbl\fs17\b Claves y restricciones\b0\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 users\cell \pard\intbl\fs17 Perfiles locales y de MovieLens\cell \pard\intbl\fs17 PK user_id; source e is_demo con CHECK.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 items\cell \pard\intbl\fs17 Cat\u225?logo unificado de pel\u237?culas y series\cell \pard\intbl\fs17 PK item_id; media_type con CHECK; \u237?ndices por a\u241?o, tipo y nota.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 genres\cell \pard\intbl\fs17 Cat\u225?logo de g\u233?neros\cell \pard\intbl\fs17 PK genre_id; nombre \u250?nico.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 item_genres\cell \pard\intbl\fs17 Relaci\u243?n muchos a muchos \u237?tem-g\u233?nero\cell \pard\intbl\fs17 PK compuesta; FKs con ON DELETE CASCADE.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 ratings\cell \pard\intbl\fs17 Valoraciones hist\u243?ricas y de la app\cell \pard\intbl\fs17 PK (user_id, item_id, source); rating entre 0,5 y 5.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 feedback\cell \pard\intbl\fs17 Like, dislike, visto, no interesado\cell \pard\intbl\fs17 UNIQUE por usuario, \u237?tem y acci\u243?n.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 interactions\cell \pard\intbl\fs17 Eventos anal\u237?ticos\cell \pard\intbl\fs17 Eventos validados con CHECK.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 conversations\cell \pard\intbl\fs17 Sesiones de chat\cell \pard\intbl\fs17 FK a users; fecha de inicio y fin.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 messages\cell \pard\intbl\fs17 Mensajes de usuario y asistente\cell \pard\intbl\fs17 FK a conversations; intenci\u243?n, confianza y entidades JSON.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 recommendations\cell \pard\intbl\fs17 Recomendaciones mostradas\cell \pard\intbl\fs17 FK a message, user e item; rank, score y motivo.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 training_runs\cell \pard\intbl\fs17 Ejecuciones de entrenamiento\cell \pard\intbl\fs17 Par\u225?metros y totales del run.\cell \row
\trowd\trgaph108\trleft0\cellx1404\cellx5148\cellx9360
\pard\intbl\fs17 model_metrics\cell \pard\intbl\fs17 M\u233?tricas por modelo y run\cell \pard\intbl\fs17 UNIQUE (model, metric, run).\cell \row
\pard\par

\pard\qc\fs17\i\cf3 Tabla 4. Tablas del esquema relacional.\i0\cf1\par
\pard\sa120\sb180\fs26\b\cf1 5.2. Relaciones y normalizaci\u243?n\b0\par
\pard\qj\sa120\sl276\slmult1\fs21 La relaci\u243?n entre \u237?tems y g\u233?neros es muchos a muchos y se resuelve con `item_genres`. Las valoraciones relacionan usuarios e \u237?tems y a\u241?aden `source` a la clave para que una nota de la app pueda convivir con la nota hist\u243?rica de MovieLens sin violar la unicidad. Las conversaciones agrupan mensajes y cada mensaje puede generar varias recomendaciones, lo que produce una jerarqu\u237?a uno-a-muchos y muchos-a-uno bien definida.\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
-- Integridad y trazabilidad de una recomendaci\u243?n\line CREATE TABLE recommendations (\line     recommendation_id INTEGER PRIMARY KEY AUTOINCREMENT,\line     message_id        INTEGER NOT NULL,\line     user_id           INTEGER NOT NULL,\line     item_id           INTEGER NOT NULL,\line     rank              INTEGER NOT NULL,\line     score             REAL    NOT NULL,\line     reason            TEXT    NOT NULL DEFAULT '',\line     FOREIGN KEY (message_id) REFERENCES messages(message_id) ON DELETE CASCADE,\line     FOREIGN KEY (user_id)    REFERENCES users(user_id)    ON DELETE CASCADE,\line     FOREIGN KEY (item_id)    REFERENCES items(item_id)    ON DELETE CASCADE\line );
\f0\par
\pard\sa120\sb180\fs26\b\cf1 5.3. Triggers, vistas y FTS5\b0\par
\pard\qj\sa120\sl276\slmult1\fs21 Los triggers mantienen `local_rating_sum`, `local_rating_count` y `local_rating_avg` en `items` cada vez que se inserta, actualiza o elimina una nota de la app. As\u237? la lectura de una tarjeta no necesita agregar toda la tabla de valoraciones. Las vistas encapsulan estad\u237?sticas y rankings. FTS5 indexa t\u237?tulo, t\u237?tulo normalizado, sinopsis y palabras clave con eliminaci\u243?n de diacr\u237?ticos, lo que permite buscar \u8220?parasitos\u8221? y encontrar \u8220?Parasite\u8221?.\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
-- B\u250?squeda full-text tolerante a tildes\line SELECT i.item_id, i.title, i.media_type\line FROM items_fts f\line JOIN items i ON i.item_id = f.rowid\line WHERE items_fts MATCH ?\line ORDER BY bm25(items_fts)\line LIMIT 10;
\f0\par
\pard\qj\sa120\sl276\slmult1\fs21 La conexi\u243?n usa `PRAGMA foreign_keys = ON`, `journal_mode = WAL` y transacciones expl\u237?citas para las operaciones que modifican varias tablas. Las consultas se construyen con par\u225?metros, no con concatenaci\u243?n de cadenas, para evitar inyecci\u243?n SQL.\par
\pard\sa180\sb240\f1\fs34\b\cf2 6. Recomendador de contenido\b0\cf1\par
\pard\sa120\sb180\fs26\b\cf1 6.1. Representaci\u243?n de los \u237?tems\b0\par
\pard\qj\sa120\sl276\slmult1\fs21 Cada pel\u237?cula o serie se transforma en un documento textual. El t\u237?tulo se repite tres veces para darle peso; se agregan los g\u233?neros can\u243?nicos y sus equivalentes en espa\u241?ol, las etiquetas de \u225?nimo derivadas del g\u233?nero, las palabras clave, la sinopsis, la d\u233?cada y el tipo de contenido. Esta representaci\u243?n permite que una consulta como \u8220?ciencia ficci\u243?n espacial\u8221? se acerque a t\u237?tulos con esos t\u233?rminos aunque el t\u237?tulo no los contenga.\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
documento = tipo + t\u237?tulo\u215?3 + g\u233?neros_es + \u225?nimos\line           + palabras_clave\u215?2 + sinopsis + d\u233?cada
\f0\par
\pard\sa120\sb180\fs26\b\cf1 6.2. TF-IDF y similitud coseno\b0\par
\pard\qj\sa120\sl276\slmult1\fs21 Se ajusta un `TfidfVectorizer` con n-gramas de una y dos palabras, `min_df=2`, `max_df=0,85`, `sublinear_tf` y normalizaci\u243?n L2. El resultado es una matriz dispersa de \b 9,832 \u215? 12,715\b0  y un vocabulario de \b 12,715 t\u233?rminos\b0 . Para cada \u237?tem se precomputan sus 40 vecinos m\u225?s similares procesando la matriz por bloques, evitando materializar una matriz densa de 9.832 \u215? 9.832.\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
tf(t,d) = 1 + log(frecuencia(t,d))\line idf(t)   = log((1 + N) / (1 + df(t))) + 1\line w(t,d)   = tf(t,d) \u183? idf(t) / ||vector(d)||\line \line sim(A,B) = (A \u183? B) / (||A|| \u183? ||B||)
\f0\par
\pard\qj\sa120\sl276\slmult1\fs21 El perfil de contenido del usuario se construye como una suma ponderada de los vectores de los \u237?tems que valor\u243?. Las notas altas pesan m\u225?s; las bajas aportan una se\u241?al negativa peque\u241?a y se descartan si no superan el umbral. La consulta combina el perfil del usuario con un vector de g\u233?neros, \u225?nimos y palabras clave, y con el \u237?tem de referencia cuando se pide \u8220?algo parecido a\u8221?.\par
\pard\qj\sa120\sl276\slmult1\fs21 La principal ventaja es que resuelve el arranque en fr\u237?o y produce explicaciones directas. La limitaci\u243?n es que solo captura similitud textual: dos pel\u237?culas pueden compartir g\u233?nero y sinopsis sin gustar al mismo p\u250?blico. Por eso se combina con el filtrado colaborativo.\par
\pard\sa180\sb240\f1\fs34\b\cf2 7. Filtrado colaborativo con FunkSVD\b0\cf1\par
\pard\sa120\sb180\fs26\b\cf1 7.1. Modelo\b0\par
\pard\qj\sa120\sl276\slmult1\fs21 FunkSVD descompone la matriz de valoraciones en factores latentes de usuario y de \u237?tem. El modelo incluye la media global y sesgos por usuario y por \u237?tem, de modo que una pel\u237?cula universalmente mejor valorada reciba un sesgo positivo y un usuario exigente reciba uno negativo.\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
r\u770?(u,i) = \u956? + b_u + b_i + p_u \u183? q_i\line \line min \u931? (r(u,i) - r\u770?(u,i))\u178? + \u955?(||p_u||\u178? + ||q_i||\u178? + b_u\u178? + b_i\u178?)
\f0\par
\pard\qj\sa120\sl276\slmult1\fs21 El aprendizaje se realiza con descenso de gradiente estoc\u225?stico. Para cada valoraci\u243?n se actualizan el error y los par\u225?metros:\par
\pard\qj\sa120\sl240\slmult1\li260\f2\fs17\cf1
e = r(u,i) - r\u770?(u,i)\line b_u \u8592? b_u + \u945? (e - \u955? b_u)\line b_i \u8592? b_i + \u945? (e - \u955? b_i)\line p_u \u8592? p_u + \u945? (e q_i - \u955? p_u)\line q_i \u8592? q_i + \u945? (e p_u - \u955? q_i)
\f0\par

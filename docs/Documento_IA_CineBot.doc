\pard\qc\f1\fs72\b\cf2 CineBot\b0\cf1\par
\pard\qc\fs30\cf1 Chatbot inteligente de recomendaci\u243?n de pel\u237?culas y series con Python, Flet, SQLite y aprendizaje autom\u225?tico\par
\pard\qc\fs24\cf2 \u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\u8212?\par
\pard\qc\fs22\cf3 Trabajo pr\u225?ctico integrador\cf1\par
\pard\qc\fs22\cf3 Programaci\u243?n \u183? Bases de Datos \u183? Inteligencia Artificial\cf1\par
\pard\qc\fs22\cf3 Autor/a: ______________________________________\cf1\par
\pard\qc\fs22\cf3 Docente: ______________________________________\cf1\par
\pard\qc\fs22\cf3 Fecha: 25/10/2026\cf1\par

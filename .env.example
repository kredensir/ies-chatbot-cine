# Variables opcionales de CineBot.
# La aplicación funciona sin ninguna clave: MovieLens y TVmaze se descargan
# como archivos públicos y los modelos se entrenan localmente.

# Ruta alternativa de la base SQLite (por defecto: ia/database/cinebot.db)
# CINEBOT_DB=C:\ruta\a\cinebot.db

# Ruta alternativa de los modelos (por defecto: ia/models)
# CINEBOT_MODELS=C:\ruta\a\models

# Clave opcional de TMDB para enriquecer sinopsis y pósters de películas.
# No es necesaria para el funcionamiento ni para la evaluación del trabajo.
# TMDB_API_KEY=tu_clave_aqui
